+/*
+ * Kernels before the ANNOTATE_* unification (AlmaLinux and Rocky 10.0)
+ * record each annotation type in a section of its own, not as typed
+ * entries in .discard.annotate_insn.  Without reading them, objtool sees
+ * every such instruction as unannotated ("unannotated intra-function
+ * call" in ftrace_regs_caller), stops, and leaves the object without
+ * checksums.  Feed them to the same handlers as the typed entries.
+ *
+ * reachable and unreachable point just past their instruction, as the
+ * old objtool read them; unreachable has no type any more and sets
+ * dead_end itself, before the early handlers run.
+ */
+static const struct {
+	const char *name;
+	int type;
+	bool prev;
+} old_annotate_secs[] = {
+	{ ".rela.discard.noendbr",		ANNOTYPE_NOENDBR,		false },
+	{ ".rela.discard.retpoline_safe",	ANNOTYPE_RETPOLINE_SAFE,	false },
+	{ ".rela.discard.instr_begin",		ANNOTYPE_INSTR_BEGIN,		false },
+	{ ".rela.discard.instr_end",		ANNOTYPE_INSTR_END,		false },
+	{ ".rela.discard.validate_unret",	ANNOTYPE_UNRET_BEGIN,		false },
+	{ ".rela.discard.ignore_alts",		ANNOTYPE_IGNORE_ALTS,		false },
+	{ ".rela.discard.intra_function_calls",	ANNOTYPE_INTRA_FUNCTION_CALL,	false },
+	{ ".rela.discard.reachable",		ANNOTYPE_REACHABLE,		true },
+};
+
+static struct instruction *old_annotate_insn(struct objtool_file *file,
+					     struct reloc *reloc, bool prev)
+{
+	struct instruction *insn, *last = NULL;
+	uint64_t offset = reloc->sym->offset + reloc_addend(reloc);
+
+	insn = find_insn(file, reloc->sym->sec, offset);
+	if (!prev)
+		return insn;
+	if (insn)
+		return prev_insn_same_sec(file, insn);
+	if (offset != sec_size(reloc->sym->sec))
+		return NULL;
+	sec_for_each_insn(file, reloc->sym->sec, insn)
+		last = insn;
+	return last;
+}
+
+static int read_old_annotate(struct objtool_file *file,
+			     int (*func)(struct objtool_file *file, int type, struct instruction *insn))
+{
+	struct instruction *insn;
+	struct section *rsec;
+	struct reloc *reloc;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(old_annotate_secs); i++) {
+		rsec = find_section_by_name(file->elf, old_annotate_secs[i].name);
+		if (!rsec)
+			continue;
+		for_each_reloc(rsec, reloc) {
+			insn = old_annotate_insn(file, reloc, old_annotate_secs[i].prev);
+			if (!insn) {
+				ERROR("bad %s entry %d", rsec->name, reloc_idx(reloc));
+				return -1;
+			}
+			if (func(file, old_annotate_secs[i].type, insn))
+				return -1;
+		}
+	}
+	return 0;
+}
+
+static int read_old_unreachable(struct objtool_file *file)
+{
+	struct instruction *insn;
+	struct section *rsec;
+	struct reloc *reloc;
+
+	rsec = find_section_by_name(file->elf, ".rela.discard.unreachable");
+	if (!rsec)
+		return 0;
+	for_each_reloc(rsec, reloc) {
+		insn = old_annotate_insn(file, reloc, true);
+		if (!insn) {
+			ERROR("bad %s entry %d", rsec->name, reloc_idx(reloc));
+			return -1;
+		}
+		insn->dead_end = true;
+	}
+	return 0;
+}
+
 static int read_annotate(struct objtool_file *file,
 			 int (*func)(struct objtool_file *file, int type, struct instruction *insn))
 {
@@ -2321,11 +2411,8 @@ static int read_annotate(struct objtool_file *file,
 	int type;
 
 	sec = find_section_by_name(file->elf, ".discard.annotate_insn");
-	if (!sec)
-		return 0;
-
-	if (!sec->rsec)
-		return 0;
+	if (!sec || !sec->rsec)
+		return read_old_annotate(file, func);
 
 	if (sec->sh.sh_entsize != 8) {
 		static bool warned = false;
@@ -2355,6 +2442,9 @@ static int read_annotate(struct objtool_file *file,
 			return -1;
 	}
 
+
+	if (read_old_annotate(file, func))
+		return -1;
 	return 0;
 }
 
@@ -2617,6 +2707,9 @@ static int decode_sections(struct objtool_file *file)
 
 	add_uaccess_safe(file);
 
+	if (read_old_unreachable(file))
+		return -1;
+
 	if (read_annotate(file, __annotate_early))
 		return -1;
 
